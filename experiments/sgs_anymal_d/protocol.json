{
  "schema": "sgs-anymal-d-figure7-pilot-v2",
  "embodiment": "ANYmal-D, nominal joint positions plus 12 joint-position offsets; externally supplied Isaac Lab public ANYmal-C-derived actuator model is a reconstruction difference",
  "num_envs": 4096,
