  "task_shape": [13, 2, 10, 20, 20],
  "control_dt_s": 0.02,
  "physics_dt_s": 0.005,
  "reward": {
    "terms": ["terminal_success", "terminal_drop_or_base_contact", "mechanical_power_l1", "joint_deviation_l1", "touchdown_vertical_velocity_squared", "nonfoot_hard_contact_count", "body_frame_forward_alignment"],
    "weights": [50, -50, -0.001, -0.05, -0.25, -0.05, 0.3],
    "step_dt_multiplier": false,
    "forward_active_ppo_updates_one_based": [1, 500],
    "forward_schedule_source": "local interpretation retained from fd5f6c3"
