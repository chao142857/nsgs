  "training_arrival_local": {"radius_m": 0.4, "height_tolerance_m": 0.36, "base_reference_m": 0.6, "tilt_deg_lt": 30, "planar_speed_m_s_lt": 0.45, "angular_speed_rad_s_lt": 1.5, "support_feet_ge": 2, "support_force_n_gt": 15, "consecutive_control_ticks": 20},
  "termination_local": {"base_force_n_gt": 30, "drop_height_m_lt": -1.05, "navigation_ticks": 500, "priority": ["drop", "base_contact", "training_arrival", "timeout"]},
  "sgs": {"target": 0.66, "concentration": 5, "temperature": 2, "history": 100, "empty_rate_local": 0.5, "epsilon": 0.0001, "epsilon_source": "Appendix B.2 Table 3 nominal; section 3.2 gives 1e-8", "write_order": "ascending environment slot within each control tick, stable for duplicate configuration IDs", "unnormalized_sampling_mass": "sqrt(max((p+epsilon)^3.3 * (1-p+epsilon)^1.7, epsilon) + epsilon)"},
  "strict_route_stand_seconds": 3.0,
  "evaluation": "read-only checkpoint replay in an independent simulation; no training sampler feedback"
}
